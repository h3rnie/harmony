# Copy to .env.local (preferred, git-ignored) or .env and fill in. Never commit either.
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/ (pipeline top-up and the live view; server-side only)
FIRMS_MAP_KEY=
# AI situation brief + "Ask Harmony" (server-side only; the app falls back to a rule-based brief without a key).
ANTHROPIC_API_KEY=
# Optional second provider (OpenAI-compatible, https://openrouter.ai/keys).
OPENROUTER_API_KEY=
# anthropic (default) | openrouter
AI_PROVIDER=
# sonnet-high (default: claude-sonnet-5-5, high effort) | opus-medium (claude-opus-5-5, medium effort)
AI_PROFILE=
# Override the model id for the chosen provider (BRIEF_MODEL is accepted as an alias).
AI_MODEL=
# Used only after an outage / 5xx / 429 and one retry on the primary: openrouter | anthropic
AI_FALLBACK=
# Model id for the fallback provider (slugs differ between providers; optional).
AI_FALLBACK_MODEL=
# Prompt-cache lifetime: 5m (default) | 1h
AI_CACHE_TTL=

# --- Public build-time settings (VITE_*): shipped in the client bundle, so never put a secret here. ---
# Public URL of the source repository, linked from the About panel ("Source code: AGPL-3.0-only").
# This is a public link, not a secret. Leave empty and the About panel shows the licence without a link.
VITE_SOURCE_URL=https://github.com/h3rnie/harmony
# Cloudflare R2 (data hosting). Account ID: Cloudflare dashboard > R2 > Overview.
R2_ACCOUNT_ID=
# R2 API token (Object Read & Write on the bucket): R2 > Manage API tokens.
R2_ACCESS_KEY_ID=
# Secret shown once when the token is created.
R2_SECRET_ACCESS_KEY=
# Bucket name, e.g. harmony-data.
R2_BUCKET=
# Public base URL of the bucket's custom domain, e.g. https://data.harmony.hernie.me
R2_PUBLIC_BASE=
