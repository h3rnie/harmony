# Copy to .env and fill in. Never commit .env.
# Free key: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=
# AI situation brief + "Ask Harmony" (server-side only; the app falls back to a rule-based brief without a key).
ANTHROPIC_API_KEY=
# Optional second provider (OpenAI-compatible, https://openrouter.ai/keys).
OPENROUTER_API_KEY=
# anthropic (default) | openrouter
AI_PROVIDER=
# sonnet-high (default: claude-sonnet-5-5, high effort) | opus-medium (claude-opus-5-5, medium effort)
AI_PROFILE=
# Override the model id for the chosen provider (BRIEF_MODEL is accepted as an alias).
AI_MODEL=
# Used only after an outage / 5xx / 429 and one retry on the primary: openrouter | anthropic
AI_FALLBACK=
# Prompt-cache lifetime: 5m (default) | 1h
AI_CACHE_TTL=
